{
  "name": "mikan-desktop-companion",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test:debug": "node --experimental-strip-types --test tests/debug-log.test.mjs",
    "icons": "tauri icon assets/mikan-icon.svg",
    "desktop": "npm run icons && tauri dev",
    "package:windows": "npm run icons && tauri build",
    "tauri": "tauri",
    "build:mobile": "tsc --noEmit && vite build --mode mobile --outDir android/app/src/main/assets --base ./"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "@tauri-apps/plugin-opener": "^2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.3",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "4.1.3",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  },
  "overrides": {
    "@tailwindcss/node": "4.1.3",
    "@tailwindcss/oxide": "4.1.3"
  }
}
