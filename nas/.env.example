# Copy to nas/.env, then generate an access key with: openssl rand -hex 32
# All credentials stay on the NAS; never commit this file.
MIKAN_REMOTE_KEY=
MIKAN_PROVIDER=nvidia
MIKAN_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MIKAN_DATA_DIR=./data
MIKAN_DB_PATH=/data/mikan-memory.sqlite3
MIKAN_SYSTEM_PROMPT_FILE=/data/persona.txt
PORT=3847
