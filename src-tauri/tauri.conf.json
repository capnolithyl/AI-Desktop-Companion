{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mikan Companion",
  "version": "0.8.23",
  "identifier": "dev.capnolithyl.mikan",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mikan Companion",
        "width": 520,
        "height": 740,
        "minWidth": 410,
        "minHeight": 580,
        "center": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../advanced_memory/server.py": "advanced-memory/server.py",
      "../advanced_memory/requirements.txt": "advanced-memory/requirements.txt",
      "../scripts/setup-advanced-memory.ps1": "advanced-memory/setup-advanced-memory.ps1"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
