{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mikan Companion",
  "version": "0.1.0",
  "identifier": "dev.capnolithyl.mikan",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mikan Companion",
        "width": 990,
        "height": 710,
        "minWidth": 770,
        "minHeight": 590,
        "center": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
